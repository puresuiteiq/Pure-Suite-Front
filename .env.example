# Fallback domain for storefront QR codes (/r/<slug>). The backend's APP_URL
# wins when the API is reachable, and the browser's own origin is the last
# resort -- so this is only needed when the frontend is deployed apart from
# its API.
# VITE_PUBLIC_SITE_URL=https://puresuiteiq.com

# Base URL for API calls. Defaults to /api (same origin as the dashboard).
# VITE_API_BASE_URL=/api

# Dev-server only: where /api is proxied to (see vite.config.js).
# VITE_API_TARGET=http://localhost:4000
